# date-released: "YYYY-MM-DD"       # set on release day
license: "MIT"
keywords:
  - qualitative data analysis
  - QDA
  - computer-assisted qualitative analysis
  - local large language models
  - evidence-bound coding
  - human-in-the-loop
  - oral history
